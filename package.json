{
  "name": "wabantu-insurance",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:api": "php apps/api/artisan serve --host=127.0.0.1 --port=8000",
    "test:api": "php apps/api/artisan test"
  }
}
